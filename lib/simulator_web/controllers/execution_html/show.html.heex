<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div class="flex items-center gap-3">
        <.link navigate={~p"/simulations"} class="btn btn-ghost btn-sm">
          <.icon name="hero-arrow-left-micro" class="size-4" />
        </.link>
        <div>
          <h1 class="text-2xl font-bold tracking-tight">{@simulation.name}</h1>
          <p class="mt-1 text-sm text-base-content/60">
            <span class="badge badge-primary badge-sm">{@simulation.algorithm}</span>
            <span class="badge badge-secondary badge-sm ml-1">{@simulation.map}</span>
            <span class="ml-2">{@simulation.swarm} agents</span>
          </p>
        </div>
      </div>
      <.link navigate={~p"/simulations/#{@simulation}"} class="btn btn-ghost btn-sm">
        <.icon name="hero-cog-6-tooth-micro" class="size-4" /> Simulation Details
      </.link>
    </div>

    <div class="flex justify-center">
      <div class="rounded-box bg-base-200 p-4 inline-block">
        <canvas
          id="simulation-canvas"
          class="block rounded-box"
          width={@map_params.width}
          height={@map_params.height}
          data-simulation-id={@simulation.id}
          data-structures={@structures_json}
        >
        </canvas>
      </div>
    </div>

    <div class="flex justify-center mt-4">
      <div style={"width: #{@map_params.width + 32}px"}>
        <div class="relative mb-2">
          <input
            id="drone-search"
            type="text"
            placeholder="Search drones..."
            class="input input-sm input-bordered w-full pl-9 font-mono"
          />
          <.icon
            name="hero-magnifying-glass-micro"
            class="size-4 absolute left-3 top-1/2 -translate-y-1/2 text-base-content/40"
          />
        </div>
        <div
          id="drone-grid"
          class="grid grid-cols-4 gap-2"
        >
        </div>
      </div>
    </div>

    <div class="flex justify-center mt-4">
      <div id="drone-detail" style={"width: #{@map_params.width + 32}px"}></div>
    </div>
  </div>
</Layouts.app>
