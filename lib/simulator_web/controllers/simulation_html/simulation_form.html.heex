<.form :let={f} for={@changeset} action={@action} class="space-y-4">
  <.input field={f[:name]} type="text" label="Name" />
  <.input field={f[:swarm]} type="number" label="Swarm size" />
  <.input
    field={f[:algorithm]}
    type="select"
    label="Algorithm"
    options={@algorithms}
  />
  <.input
    field={f[:map]}
    type="select"
    label="Map"
    options={@maps}
  />
  <.input
    field={f[:objective]}
    type="select"
    label="Objective"
    options={@objectives}
  />
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <.input
      field={f[:objective_seed]}
      type="number"
      label="Objective seed (optional)"
      placeholder="Leave blank for a random seed per run"
    />
    <.input
      field={f[:swarm_seed]}
      type="number"
      label="Swarm seed (optional)"
      placeholder="Leave blank for a random seed per run"
    />
  </div>

  <footer class="flex items-center gap-3 pt-2">
    <.button variant="primary">Save Simulation</.button>
    <.button :if={@return_to} href={@return_to}>Cancel</.button>
  </footer>
</.form>
