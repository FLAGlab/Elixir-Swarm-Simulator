<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div class="flex items-center gap-3">
        <.link navigate={~p"/simulations"} class="btn btn-ghost btn-sm">
          <.icon name="hero-arrow-left-micro" class="size-4" />
        </.link>
        <div>
          <h1 class="text-2xl font-bold tracking-tight">{@simulation.name}</h1>
          <p class="mt-1 text-sm text-base-content/60">Simulation #{@simulation.id}</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <.link navigate={~p"/execution/#{@simulation}"} class="btn btn-primary btn-sm">
          <.icon name="hero-play-micro" class="size-4" /> Run Simulation
        </.link>
        <.link
          navigate={~p"/simulations/#{@simulation}/edit?return_to=show"}
          class="btn btn-ghost btn-sm"
        >
          <.icon name="hero-pencil-square-micro" class="size-4" /> Edit
        </.link>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Name</p>
        <p class="text-lg font-semibold">{@simulation.name}</p>
      </div>
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Algorithm</p>
        <p class="text-lg font-semibold">
          <span class="badge badge-primary">{@simulation.algorithm}</span>
        </p>
      </div>
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Map</p>
        <p class="text-lg font-semibold">
          <span class="badge badge-secondary">{@simulation.map}</span>
        </p>
      </div>
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Swarm Size</p>
        <div class="flex items-center gap-2">
          <.icon name="hero-user-group-micro" class="size-5 text-base-content/60" />
          <p class="text-lg font-semibold">{@simulation.swarm} agents</p>
        </div>
      </div>
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Objective</p>
        <p class="text-lg font-semibold">
          <span class="badge badge-error">{@simulation.objective}</span>
        </p>
      </div>
    </div>

    <%!-- Execution Runs --%>
    <div class="mt-8">
      <h2 class="text-lg font-semibold mb-4">Execution History</h2>

      <div :if={@execution_runs == []} class="rounded-box bg-base-200 p-8 text-center">
        <.icon name="hero-clock" class="size-8 text-base-content/30 mx-auto" />
        <p class="mt-3 text-base-content/60 text-sm">
          No executions yet. Run the simulation to see results here.
        </p>
      </div>

      <div :if={@execution_runs != []} class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>#</th>
              <th>Status</th>
              <th>Duration</th>
              <th>Ticks</th>
              <th>Finder</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr :for={run <- @execution_runs}>
              <td class="font-mono">{run.id}</td>
              <td>
                <span class="badge badge-success badge-sm">{run.status}</span>
              </td>
              <td class="font-mono">{run.duration_ms} ms</td>
              <td class="font-mono">{run.ticks}</td>
              <td class="font-mono">Drone {run.finder_drone_id}</td>
              <td class="text-base-content/60 text-sm">
                {Calendar.strftime(run.inserted_at, "%Y-%m-%d %H:%M")}
              </td>
              <td>
                <.link navigate={~p"/execution_runs/#{run}"} class="btn btn-ghost btn-xs">
                  <.icon name="hero-eye-micro" class="size-4" /> View
                </.link>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layouts.app>
