<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div class="flex items-center gap-3">
        <.link navigate={~p"/simulations"} class="btn btn-ghost btn-sm">
          <.icon name="hero-arrow-left-micro" class="size-4" />
        </.link>
        <div>
          <h1 class="text-2xl font-bold tracking-tight">Execution Results</h1>
          <p class="mt-1 text-sm text-base-content/60">
            <span class="badge badge-success badge-sm">{@execution_run.status}</span>
          </p>
        </div>
      </div>
      <.link
        navigate={~p"/execution/#{@execution_run.simulation_id}"}
        class="btn btn-primary btn-sm"
      >
        <.icon name="hero-play-micro" class="size-4" /> Run Again
      </.link>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Algorithm</p>
        <p class="text-lg font-semibold">
          <span class="badge badge-primary">{@execution_run.algorithm}</span>
        </p>
      </div>
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Map</p>
        <p class="text-lg font-semibold">
          <span class="badge badge-secondary">{@execution_run.map}</span>
        </p>
      </div>
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Objective</p>
        <p class="text-lg font-semibold">
          <span class="badge badge-error">{@execution_run.objective}</span>
        </p>
      </div>
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Swarm Size</p>
        <div class="flex items-center gap-2">
          <.icon name="hero-user-group-micro" class="size-5 text-base-content/60" />
          <p class="text-lg font-semibold">{@execution_run.swarm_size} agents</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Duration</p>
        <p class="text-lg font-semibold">{@execution_run.duration_ms} ms</p>
      </div>
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Ticks</p>
        <p class="text-lg font-semibold">{@execution_run.ticks}</p>
      </div>
      <div class="rounded-box bg-base-200 p-6">
        <p class="text-sm text-base-content/60 mb-1">Finder Drone</p>
        <p class="text-lg font-semibold">Drone {@execution_run.finder_drone_id}</p>
      </div>
    </div>

    <%= if @execution_run.objective_position do %>
      <div class="mt-6">
        <div class="rounded-box bg-base-200 p-6 inline-block">
          <p class="text-sm text-base-content/60 mb-1">Objective Position</p>
          <p class="text-lg font-semibold font-mono">{@execution_run.objective_position}</p>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
